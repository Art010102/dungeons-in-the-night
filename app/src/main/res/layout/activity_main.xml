<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <com.dungeonsnight.game.GameView
        android:id="@+id/gameView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- HUD -->
    <LinearLayout
        android:id="@+id/hud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:orientation="vertical"
        android:visibility="gone">
        <TextView
            android:id="@+id/hudLevel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/subtle"
            android:textAllCaps="true"
            android:letterSpacing="0.16"
            android:textSize="11sp" />
        <LinearLayout
            android:id="@+id/hpRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <View
                android:id="@+id/manaCell"
                android:layout_width="28dp"
                android:layout_height="8dp"
                android:background="@drawable/pad_circle" />
            <TextView
                android:id="@+id/hudCoins"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="0/3"
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/btnPause"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:background="@drawable/btn_ghost"
        android:text="II"
        android:textColor="@color/fg"
        android:visibility="gone" />

    <!-- Touch: D-pad left, jump + attack right -->
    <FrameLayout
        android:id="@+id/touchBar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="168dp"
            android:layout_height="168dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/pad_plate">

            <ImageButton
                android:id="@+id/btnJumpDpad"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="8dp"
                android:background="@drawable/pad_circle"
                android:contentDescription="@string/jump"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_arrow_up" />

            <ImageButton
                android:id="@+id/btnLeft"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="8dp"
                android:background="@drawable/pad_circle"
                android:contentDescription="@string/left"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_arrow_left" />

            <ImageButton
                android:id="@+id/btnRight"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="8dp"
                android:background="@drawable/pad_circle"
                android:contentDescription="@string/right"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_arrow_right" />

            <ImageButton
                android:id="@+id/btnDrop"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="8dp"
                android:background="@drawable/pad_circle"
                android:contentDescription="@string/drop"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_arrow_down" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="20dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnSpell"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="36dp"
                android:background="@drawable/pad_circle_action"
                android:contentDescription="@string/spell"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_spell" />

            <ImageButton
                android:id="@+id/btnAttack"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/pad_circle_action"
                android:contentDescription="@string/attack"
                android:padding="18dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_sword" />

            <ImageButton
                android:id="@+id/btnJump"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginBottom="28dp"
                android:background="@drawable/pad_circle_action"
                android:contentDescription="@string/jump"
                android:padding="14dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_arrow_up" />
        </LinearLayout>
    </FrameLayout>

    <!-- Menu -->
    <LinearLayout
        android:id="@+id/menuOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp">
        <TextView
            android:id="@+id/menuEyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/eyebrow"
            android:textAllCaps="true"
            android:textColor="@color/gold"
            android:letterSpacing="0.22"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/menuTitle1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/title_line1"
            android:textColor="@color/fg"
            android:textSize="42sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/menuTitle2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_line2"
            android:textColor="@color/muted"
            android:textSize="36sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/menuBlurb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:maxWidth="320dp"
            android:text="@string/blurb"
            android:textColor="@color/muted"
            android:textSize="14sp" />
        <Button android:id="@+id/btnStart" style="@style/BtnPrimary" android:layout_marginTop="32dp" android:text="@string/start_game" />
        <Button android:id="@+id/btnLevels" style="@style/BtnGhost" android:text="@string/select_level" />
        <Button android:id="@+id/btnSettings" style="@style/BtnGhost" android:text="@string/settings" />
        <TextView
            android:id="@+id/xpLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textColor="@color/fg"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Levels -->
    <LinearLayout
        android:id="@+id/levelsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">
        <TextView android:id="@+id/levelsTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/select_level" android:textColor="@color/fg" android:textSize="32sp" android:textStyle="bold" />
        <Button android:id="@+id/btnL1" style="@style/BtnGhost" android:layout_marginTop="24dp" android:text="@string/level_1" />
        <Button android:id="@+id/btnL2" style="@style/BtnGhost" android:text="@string/level_2" />
        <Button android:id="@+id/btnL3" style="@style/BtnGhost" android:text="@string/level_3" />
        <Button android:id="@+id/btnLevelsBack" style="@style/BtnGhost" android:text="@string/back" />
    </LinearLayout>

    <!-- Settings -->
    <LinearLayout
        android:id="@+id/settingsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">
        <TextView android:id="@+id/settingsTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/settings" android:textColor="@color/fg" android:textSize="32sp" android:textStyle="bold" />
        <TextView android:id="@+id/settingsVolume" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="28dp" android:text="@string/volume" android:textAllCaps="true"
            android:textColor="@color/subtle" android:textSize="12sp" />
        <SeekBar
            android:id="@+id/volumeBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:max="100" />
        <TextView android:id="@+id/volumeValue" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:textColor="@color/muted" />
        <TextView android:id="@+id/settingsLanguage" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="@string/language" android:textAllCaps="true"
            android:textColor="@color/subtle" android:textSize="12sp" />
        <Spinner
            android:id="@+id/languageSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/btn_ghost"
            android:popupBackground="@color/surface_solid"
            android:spinnerMode="dropdown" />
        <Button android:id="@+id/btnSettingsBack" style="@style/BtnGhost" android:layout_marginTop="24dp" android:text="@string/back" />
    </LinearLayout>

    <!-- Pause -->
    <LinearLayout
        android:id="@+id/pauseOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC120E0C"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/panel" android:orientation="vertical" android:padding="24dp">
            <TextView android:id="@+id/pauseTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:text="@string/paused" android:textColor="@color/fg" android:textSize="32sp" android:textStyle="bold" />
            <Button android:id="@+id/btnResume" style="@style/BtnPrimary" android:layout_marginTop="24dp" android:text="@string/resume" />
            <Button android:id="@+id/btnPauseExit" style="@style/BtnGhost" android:text="@string/exit" />
        </LinearLayout>
    </LinearLayout>

    <!-- Win -->
    <LinearLayout
        android:id="@+id/winOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC120E0C"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/panel" android:orientation="vertical" android:padding="24dp">
            <TextView android:id="@+id/winEyebrow" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:text="@string/banner_yours" android:textAllCaps="true" android:textColor="@color/gold" android:textSize="12sp" />
            <TextView android:id="@+id/winTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:layout_marginTop="6dp" android:text="@string/you_win" android:textColor="@color/fg" android:textSize="36sp" android:textStyle="bold" />
            <TextView android:id="@+id/winXp" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:layout_marginTop="12dp" android:textColor="@color/fg" android:textSize="22sp" />
            <TextView android:id="@+id/winHint" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:layout_marginTop="8dp" android:textColor="@color/muted" android:textSize="14sp" />
            <Button android:id="@+id/btnNextYes" style="@style/BtnPrimary" android:layout_marginTop="24dp" android:text="@string/next_yes" />
            <Button android:id="@+id/btnNextNo" style="@style/BtnGhost" android:text="@string/next_no" />
        </LinearLayout>
    </LinearLayout>

    <!-- Dead -->
    <LinearLayout
        android:id="@+id/deadOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC120E0C"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/panel" android:orientation="vertical" android:padding="24dp">
            <TextView android:id="@+id/deadEyebrow" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:text="@string/torch_out" android:textAllCaps="true" android:textColor="@color/subtle" android:textSize="12sp" />
            <TextView android:id="@+id/deadTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:layout_marginTop="6dp" android:text="@string/game_over" android:textColor="@color/fg" android:textSize="36sp" android:textStyle="bold" />
            <Button android:id="@+id/btnRestart" style="@style/BtnPrimary" android:layout_marginTop="24dp" android:text="@string/restart" />
            <Button android:id="@+id/btnDeadExit" style="@style/BtnGhost" android:text="@string/exit" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
