<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DungeonsNight" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:colorPrimary">@color/gold</item>
        <item name="android:textColor">@color/fg</item>
        <item name="android:fontFamily">@font/cinzel</item>
        <item name="fontFamily">@font/cinzel</item>
    </style>
    <style name="TitleCarved">
        <item name="android:fontFamily">@font/cinzel</item>
        <item name="fontFamily">@font/cinzel</item>
        <item name="android:textStyle">bold</item>
        <item name="android:shadowColor">#E6000000</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">3</item>
        <item name="android:shadowRadius">8</item>
    </style>
    <style name="BtnPrimary">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:background">@drawable/btn_primary</item>
        <item name="android:textColor">@color/carved_gold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:fontFamily">@font/cinzel</item>
        <item name="fontFamily">@font/cinzel</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:shadowColor">#CC000000</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">2</item>
        <item name="android:shadowRadius">3</item>
    </style>
    <style name="BtnGhost">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">58dp</item>
        <item name="android:background">@drawable/btn_ghost</item>
        <item name="android:textColor">@color/carved</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:fontFamily">@font/cinzel</item>
        <item name="fontFamily">@font/cinzel</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:shadowColor">#CC000000</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">2</item>
        <item name="android:shadowRadius">3</item>
    </style>
    <style name="Pad">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:background">@drawable/pad_circle</item>
        <item name="android:textColor">@color/fg</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>
