<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#38EFE6D8" />
            <stroke android:width="1.5dp" android:color="#66EFE6D8" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#1AEFE6D8" />
            <stroke android:width="1.5dp" android:color="#33EFE6D8" />
        </shape>
    </item>
</selector>
